{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Solution",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Ez3D-i.Installer.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run All 6 Install Cases (TC01–TC06)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/Ez3D-i.Installer.csproj",
                "--filter",
                "Category=Installation",
                "--logger",
                "console;verbosity=normal"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Run TC01: Clean Installation",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/Ez3D-i.Installer.csproj",
                "--filter",
                "FullyQualifiedName~TC01_Clean_Installation",
                "--logger",
                "console;verbosity=normal"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run TC02: Post-Install Verify",
